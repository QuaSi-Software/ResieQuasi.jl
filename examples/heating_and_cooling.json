{
    "io_settings": {
        "csv_output_file_path": "./output/out.csv",
        "auxiliary_info": true,
        "auxiliary_info_file_path": "./output/auxiliary_info.md",
        "sankey_plot_file_path": "./output/output_sankey.html",
        "sankey_plot": "default",
        "csv_output": "nothing",
        "output_plot_file_path": "./output/output_plot.html",
        "output_plot": "all_incl_flows"
    },
    "simulation_parameters": {
        "start": "01.01.2024 00:00",
        "end": "07.01.2024 23:45",
        "start_date_format": "dd.mm.yyyy HH:MM",
        "time_step": 15,
        "time_step_unit": "minutes"
    },
    "components": {
        "TST_TH_DEM_01": {
            "type": "FixedSink",
            "medium": "m_h_w_ht1",
            "output_refs": [],
            "energy_profile_file_path": "./profiles/examples/general/dem_heat_nrg_var_hi-amp.prf",
            "temperature_profile_file_path": "./profiles/examples/general/dem_heat_temp_var_avg55.prf",
            "scale": 2000.0
        },
        "TST_TH_DEM_02": {
            "type": "FixedSupply",
            "medium": "m_h_w_lt1",
            "output_refs": ["TST_TH_BUS_02"],
            "energy_profile_file_path": "./profiles/examples/general/src_heat_maxpow_dailyvar_lo-amp.prf",
            "temperature_profile_file_path": "./profiles/examples/general/src_heat_temp_dailyvar_avg30.prf",
            "scale": 3000.0
        },
        "TST_TH_BUS_01": {
            "type": "Bus",
            "medium": "m_h_w_ht1",
            "connections": {
                "input_order": [
                    "TST_TH_HP_01",
                    "TST_TH_BFT_01"
                ],
                "output_order": [
                    "TST_TH_DEM_01",
                    "TST_TH_BFT_01"
                ],
                "energy_flow": [
                    [1, 1],
                    [1, 0]
                ]
            }
        },
        "TST_TH_BUS_02": {
            "type": "Bus",
            "medium": "m_h_w_lt1",
            "connections": {
                "input_order": [
                    "TST_TH_DEM_02"
                ],
                "output_order": [
                    "TST_TH_HP_01",
                    "TST_TH_HP_02"
                ],
				"energy_flow": [
				  [1, 1 ]
				]
            }
        },
        "TST_EL_BUS_01": {
            "type": "Bus",
            "medium": "m_e_ac_230v",
            "connections": {
                "input_order": [
                    "TST_EL_GRI_01"
                ],
                "output_order": [
                    "TST_TH_HP_01",
                    "TST_TH_HP_02"
                ],
				"energy_flow": [
				  [1, 1]
				]
			}
        },
        "TST_TH_BFT_01": {
            "type": "BufferTank",
            "output_refs": [
                "TST_TH_BUS_01"
            ],
            "model_type": "ideally_stratified",
            "capacity": 80000,
            "initial_load": 0.5,
            "high_temperature": 70.0
        },
        "TST_TH_HP_01": {
            "type": "HeatPump",
            "output_refs": [
                "TST_TH_BUS_01"
            ],
            "m_heat_out": "m_h_w_ht1",
            "control_modules": [
                {
                    "name": "storage_driven",
                    "high_threshold": 0.95,
                    "low_threshold": 0.2,
                    "storage_uac": "TST_TH_BFT_01"
                }
            ],
            "power_th": 4500,
            "min_power_function": "const:0.3",
            "power_losses_factor": 1.0,
            "heat_losses_factor": 1.0
        },
        "TST_TH_HP_02": {
            "type": "HeatPump",
            "output_refs": [
                "TST_TH_GRO_01"
            ],
            "m_heat_out": "m_h_w_lt2",
            "power_th": 3500,
            "output_temperature": 40.0,
            "power_losses_factor": 1.0,
            "heat_losses_factor": 1.0
        },
        "TST_EL_GRI_01": {
            "type": "GridSupply",
            "medium": "m_e_ac_230v",
            "output_refs": [
                "TST_EL_BUS_01"
            ]
        },
        "TST_TH_GRO_01": {
            "type": "GridSink",
            "medium": "m_h_w_lt2",
            "output_refs": []
        }
    }
}