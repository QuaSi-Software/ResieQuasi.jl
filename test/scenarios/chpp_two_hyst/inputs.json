{
    "io_settings": {
        "auxiliary_info": true,
        "auxiliary_info_file_path": "./test/scenarios/chpp_two_hyst//auxiliary_info.md",
        "fixed_output_precision": 10,
        "sankey_plot_file_path": "./test/scenarios/chpp_two_hyst/sankey_plot.html",
        "sankey_plot": "default",
        "csv_output_file_path": "./test/scenarios/chpp_two_hyst/out.csv",
        "csv_output": "custom",
        "csv_output_keys": {
            "m_h_w_ht1":  ["TST_CHP_01->TST_DEM_01", "TST_CHP_01->TST_BT_01", "TST_CHP_01->TST_GRO_01"]
        },
        "output_plot_file_path": "./test/scenarios/chpp_two_hyst/output_plot.html",
        "output_plot": "all_excl_flows"
    },
    "simulation_parameters": {
        "start": "01.01.2024 00:00",
        "end": "07.01.2024 23:30",
        "start_date_format": "dd.mm.yyyy HH:MM",
        "time_step": 15,
        "time_step_unit": "minutes"
    },
    "components": {
        "TST_DEM_01" : {
            "type" : "Demand",
            "medium" : "m_h_w_ht1",
            "output_refs" : [],
            "energy_profile_file_path" : "./profiles/examples/general/dem_heat_nrg_var_hi-amp.prf",
            "scale" : 1000.0,
            "constant_temperature": 60.0
        },
        "TST_DEM_02" : {
            "type" : "Demand",
            "medium" : "m_e_ac_230v",
            "output_refs" : [],
            "energy_profile_file_path" : "./profiles/examples/district/demand_electricity_85Living_15Business_Wh_per_square_meter.prf",
            "scale" : 200.0
        },
        "TST_GRI_01" : {
            "type" : "GridSupply",
            "medium" : "m_c_g_natgas",
            "output_refs" : ["TST_CHP_01"]
        },
        "TST_GRO_01" : {
            "type" : "GridSink",
            "medium" : "m_h_w_ht1",
            "output_refs" : []
        },
        "TST_BT_01": {
            "type": "BufferTank",
            "output_refs": [
                "TST_BUS_01"
            ],
            "___GENERAL PARAMETER___": "",
            "model_type": "balanced",
            "capacity": 7000,
            "initial_load": 0.5,
            "high_temperature": 60.0,
            "max_load_rate": 1.0,
            "max_unload_rate": 1.0,
            "___BALANCED MODEL___": "",
            "switch_point": 0.20,
            "___LOSSES___": "",
            "consider_losses": true,
            "h_to_r": 2,
            "constant_ambient_temperature": 18,
            "ground_temperature": 12,
            "thermal_transmission_lid": 0.9,
            "thermal_transmission_barrel": 1.2,
            "thermal_transmission_bottom": 1.5
        },
        "TST_BAT_01": {
            "type": "Battery",
            "m_el_in": "m_e_ac_230v",
            "m_el_out": "m_e_ac_230v",
            "output_refs": [
                "TST_BUS_02"
            ],
            "capacity": 8000,
            "initial_load": 0.5,
            "charge_efficiency": 1.0,
            "discharge_efficiency": 1.0
        },
        "TST_BUS_01": {
            "type": "Bus",
            "medium": "m_h_w_ht1",
            "connections": {
                "input_order": [
                    "TST_CHP_01",
                    "TST_BT_01"
                ],
                "output_order": [
                    "TST_DEM_01",
                    "TST_BT_01",
                    "TST_GRO_01"
                ],
                "energy_flow": [
                    [1,1,1],
                    [1,0,0]
                ]
            }
        },
        "TST_BUS_02": {
            "type": "Bus",
            "medium": "m_e_ac_230v",
            "connections": {
                "input_order": [
                    "TST_CHP_01",
                    "TST_BAT_01"
                ],
                "output_order": [
                    "TST_DEM_02",
                    "TST_BAT_01"
                ]
            }
        },
        "TST_CHP_01" : {
            "type" : "CHPP",
            "m_fuel_in" : "m_c_g_natgas",
            "output_refs" : {
                "m_heat_out": "TST_BUS_01",
                "m_el_out": "TST_BUS_02"
            },
            "control_modules": [
                {
                    "name": "storage_driven",
                    "low_threshold": 0.2,
                    "high_threshold": 0.8,
                    "storage_uac": "TST_BAT_01"
                },
                {
                    "name": "storage_driven",
                    "low_threshold": 0.3,
                    "high_threshold": 0.9,
                    "storage_uac": "TST_BT_01"
                }
            ],
            "power_el" : 1500,
            "min_power_fraction" : 0.4
        }
    }
}